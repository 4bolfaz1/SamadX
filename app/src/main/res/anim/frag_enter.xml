<?xml version="1.0" encoding="utf-8"?>
<!-- ورود صفحه‌ی جدید (fade-through): بعد از محو شدن صفحه‌ی قبلی، با کمی بزرگ‌شدن ظاهر می‌شود -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/decelerate_cubic">
    <alpha
        android:duration="210"
        android:fromAlpha="0"
        android:startOffset="90"
        android:toAlpha="1" />
    <scale
        android:duration="210"
        android:fromXScale="0.96"
        android:fromYScale="0.96"
        android:pivotX="50%"
        android:pivotY="30%"
        android:startOffset="90"
        android:toXScale="1"
        android:toYScale="1" />
</set>
